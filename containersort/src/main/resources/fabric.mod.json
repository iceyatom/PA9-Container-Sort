{
	"schemaVersion": 1,
	"id": "containersort",
	"version": "${version}",
	"name": "PA9 Container Sort",
	"description": "One-click alphabetical sorting for chests, barrels, and shulker boxes.",
	"authors": [
		"PersonalAtom9"
	],
	"contact": {
		"homepage": "https://www.youtube.com/@PersonalAtom9"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.iceyatom.containersort.client.ContainerSortClient"
		]
	},
	"mixins": [
		{
			"config": "containersort.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.155.2"
	},
	"suggests": {
		"modmenu": "*"
	}
}
